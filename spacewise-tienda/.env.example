# Copia este archivo como .env y ajusta los valores. .env NO se sube al repositorio.

# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos MySQL
DB_NAME=spacewise_db
DB_USER=root
DB_PASSWORD=tu-contraseña-de-mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# Correos que reciben aviso de pedidos nuevos (separados por coma)
PEDIDOS_NOTIFY_EMAILS=
