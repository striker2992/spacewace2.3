# ==============================================================================
# Variables de entorno para despliegue con Docker Compose
# Copia este archivo como .env dentro de spacewise-tienda/ en el servidor:
#   cp .env.docker.example .env
# ==============================================================================

# Clave secreta de Django (OBLIGATORIA para producción)
# Generar una segura ejecutando:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-segura

# Modo Debug (0 para producción, 1 para desarrollo local)
DJANGO_DEBUG=0

# Dominios y/o IPs permitidos (separados por coma)
# Ejemplo: mi-dominio.com,www.mi-dominio.com,192.168.1.50
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,tu-ip-o-dominio.com

# Puerto público en el host donde escuchará la app
PUERTO_HTTP=8000

# Base de datos MySQL
DB_NAME=spacewise_db
DB_USER=spacewise
DB_PASSWORD=contrasena_super_segura_db_usuario
DB_ROOT_PASSWORD=contrasena_super_segura_root

# Ejecutar seed de datos demo automáticamente al levantar (1 = sí, 0 = no)
# Recomendado: 1 solo la primera vez si quieres datos iniciales de prueba, luego 0.
SEED_DATABASE=0

# HTTPS y Proxy Inverso (Nginx)
# Si pones Nginx con SSL/HTTPS delante:
DJANGO_HTTPS=0
DJANGO_HTTPS_REDIRIGIR=0
DJANGO_IP_CABECERA=X-Real-IP
DJANGO_SERVIR_MEDIA=1

# Notificaciones por correo
PEDIDOS_NOTIFY_EMAILS=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-token-o-clave
# DEFAULT_FROM_EMAIL=SpaceWise <tu-correo@gmail.com>
