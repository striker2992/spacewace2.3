# Copia este archivo como .env y ajusta los valores. .env NO se sube al repositorio.

# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos MySQL
DB_NAME=spacewise_db
DB_USER=root
DB_PASSWORD=tu-contraseña-de-mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# Horas sin actividad tras las que se cierra la sesión
DJANGO_SESSION_HORAS=8

# Correos que reciben aviso de pedidos nuevos (separados por coma)
PEDIDOS_NOTIFY_EMAILS=

# Envío de correos (recuperar contraseña, avisos). Sin esto se muestran en la consola.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion
# DEFAULT_FROM_EMAIL=SpaceWise <tu-correo@gmail.com>

# ---------------------------------------------------------------------------
# Solo en el servidor de la demo (ver «Despliegue» en el README)
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=tu-usuario.pythonanywhere.com
# DJANGO_HTTPS=1            # cookies seguras, redirección a https y HSTS
# DJANGO_HTTPS_REDIRIGIR=1  # 0 si el hosting ya fuerza https (PythonAnywhere: «Force HTTPS»)
# DJANGO_IP_CABECERA=X-Real-IP   # PythonAnywhere: cabecera con la IP real del visitante
# DJANGO_PROXY_SALTOS=1     # otros hostings: proxies delante (IP real para el límite de intentos)
# DJANGO_SERVIR_MEDIA=1     # 0 si el hosting sirve /media/ por su cuenta
